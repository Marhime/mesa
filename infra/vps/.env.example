# Mesa on the VPS: copy to .env (cp .env.example .env) and fill in. Read by both services.

# --- worker -------------------------------------------------------------------------------------
# Supabase → Project settings → API. The service role (secret) key bypasses RLS: never ship it in the app.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR-GEMINI-API-KEY
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when GEMINI_MODEL is overloaded (503/504/429) or retired. "none" turns this off.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash

POLL_INTERVAL_MS=3000
WORKER_CONCURRENCY=1

# yt-dlp is installed in the image. For Instagram, put a cookies.txt (Netscape format, exported from
# a logged-in browser session) in infra/vps/secrets/ and uncomment:
# YTDLP_COOKIES=/secrets/cookies.txt

# LOG_LEVEL=info
# Only if "Enhanced push security" is enabled in the Expo project:
# EXPO_ACCESS_TOKEN=

# --- backup ----------------------------------------------------------------------------------------
# Supabase → Connect → Session pooler (port 5432, works over IPv4). Use the database password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# One dump file per schema. "auth" holds the accounts; drop it if your role may not read it.
# BACKUP_SCHEMAS=public auth
# BACKUP_KEEP_DAYS=14
# BACKUP_AT=03:30
