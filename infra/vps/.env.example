# Mesa on a VPS: copy to .env (cp .env.example .env), fill in, chmod 600 .env. See README.md.
# The worker refuses to start while a value still has a YOUR-… placeholder.

# --- worker (apps/worker) -------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project settings → API keys → service_role (or the sb_secret_… key), never the anon key.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
GEMINI_API_KEY=YOUR-GEMINI-API-KEY
# GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is busy or retired; "none" turns them off.
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash

# How often an idle slot looks at the queue (ms). New jobs also wake idle slots at once over Realtime.
# POLL_INTERVAL_MS=3000
# Slots that take every kind of job (quick ones first), 1 to 8.
# WORKER_CONCURRENCY=1
# Extra slots that take only quick jobs (Ask Mesa), so a question never waits behind an import or a
# video search; 0 to 4, 0 = none. Needs migration 20261106000020_ask_fast_lane.sql.
# WORKER_QUICK_SLOTS=1

# Instagram cookies.txt (Netscape format) in ./secrets, mounted read-only at /secrets.
# YTDLP_COOKIES=/secrets/cookies.txt
# Only when "Enhanced push security" is on in the Expo project.
# EXPO_ACCESS_TOKEN=
# healthchecks.io ping URL: pinged about once a minute while the worker can reach the queue.
# HEALTHCHECK_URL=
# LOG_LEVEL=info
# The day's (UTC) ceiling on AI spend: past it, every job that needs the model fails with "Mesa has read a
# lot today. Try again tomorrow." (aiDailyLimit) until midnight UTC. Tokens: input + output, thinking
# included. Counted in ai_usage (migration 20261107000028) for every worker; without it, per worker run.
# AI_DAILY_TOKEN_LIMIT=20000000
# AI_DAILY_CALL_LIMIT=3000
# Pause after a job the server queued itself (rereads, tidying, For you) before the next claim, unless a new
# job comes in (ms, default 30000): keeps server work under Gemini's per-minute limits (5 a minute per model
# on the free tier) and leaves them to people. 0 = no pause.
# SERVER_JOB_GAP_MS=30000

# --- backup ---------------------------------------------------------------------------------------
# Supabase → Connect → Session pooler connection string, with the database password filled in.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
# BACKUP_SCHEMAS=public auth
# BACKUP_KEEP_DAYS=14
# BACKUP_AT=03:30
# healthchecks.io ping URL for the nightly backup.
# HEALTHCHECK_BACKUP_URL=
